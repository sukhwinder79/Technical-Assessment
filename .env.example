# ============================================================================
#  Agentic AI Developer — Technical Assessment
#  Copy this file to `.env` and fill in the values you need.
# ============================================================================

# ---- LLM provider ----------------------------------------------------------
# Which LLM drives the agent. Every option below except `anthropic` speaks the
# OpenAI chat-completions format, so one adapter serves them all.
#
#   groq        FREE tier, very fast, tool calling  <- recommended default
#   anthropic   Claude (paid; supports adaptive thinking + effort)
#   openai      OpenAI (paid)
#   openrouter  aggregator, has free models
#   together    Together AI
#   ollama      fully local, no key and no internet needed
#   custom      set LLM_BASE_URL + LLM_API_KEY yourself
#   auto        pick the first provider that has a key (prefers free Groq)
LLM_PROVIDER=groq

# --- Groq (free) ------------------------------------------------------------
# Get a key in ~30 seconds, no credit card: https://console.groq.com/keys
#
# Put the REAL key in `.env` (gitignored), never in this file — `.env.example`
# is committed, so anything written here ends up in your repo history.
GROQ_API_KEY=gsk_your_key_here

# Leave LLM_MODEL blank to use the provider's default.
# Good Groq models with reliable tool calling:
#   llama-3.3-70b-versatile     (default — best all-round on the free tier)
#   openai/gpt-oss-120b         (stronger reasoning, larger)
#   llama-3.1-8b-instant        (fastest / cheapest, weaker at multi-step plans)
# Current list: https://console.groq.com/docs/models
LLM_MODEL=

# --- Anthropic (optional; only used when LLM_PROVIDER=anthropic) ------------
# ANTHROPIC_API_KEY=sk-ant-...
# Reasoning depth, Anthropic only: low | medium | high | xhigh | max
# AGENT_EFFORT=medium

# --- Other providers (optional) ---------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...
# For LLM_PROVIDER=ollama, run `ollama serve` first — no key needed.
# For LLM_PROVIDER=custom:
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...


# ---- Agent loop ------------------------------------------------------------
# NOT a "bigger is safer" setting: providers reserve max_tokens against their
# per-minute rate limit, so an over-provisioned value gets requests rejected
# before they are read. Measured on Groq's free tier — a 1,315-token prompt with
# max_tokens=8000 was counted as 9,315 against an 8,000/min cap and refused; the
# same prompt at 2000 succeeded. The agent's longest output is ~1,000 tokens.
AGENT_MAX_TOKENS=2000
AGENT_MAX_ITERATIONS=25

# Run an explicit planning pass before executing tools (bonus: multi-step planning)
AGENT_PLANNING=true

# Smaller open models handle one tool call per turn far more reliably than
# several. Set false to let the model fan out.
LLM_DISABLE_PARALLEL_TOOL_CALLS=true


# ---- Paths -----------------------------------------------------------------
WORKSPACE_DIR=./workspace
LOG_DIR=./logs
MEMORY_DIR=./.agent_memory
TOOLS_CONFIG=./config/tools.yaml


# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# true  -> JSON lines on stderr (production / log shipping)
# false -> pretty console output (demo)
LOG_JSON=false


# ---- Microsoft Excel (Windows) ---------------------------------------------
# Show the Excel window while the agent works (great for the demo video).
EXCEL_VISIBLE=true
# Leave Excel open after saving so the imported data stays on screen.
EXCEL_KEEP_OPEN=true


# ---- Google Sheets ---------------------------------------------------------
#
# IMPORTANT: a service account CANNOT create a spreadsheet. Google removed free
# Drive storage from service accounts, and every Drive file needs an owner with
# storage, so `spreadsheets.create` fails with a bare 403 even when both APIs
# are enabled. Two working setups:
#
#   oauth           -> the agent creates sheets in YOUR Drive. Needs one browser
#                      consent, then caches a token. Best for the demo.
#   service_account -> fully headless, but you must point it at a sheet you own
#                      (see GOOGLE_SPREADSHEET_ID below).
#
# service_account | oauth | disabled
GOOGLE_AUTH_MODE=oauth

# --- Mode: oauth (recommended) ----------------------------------------------
# Google Cloud -> Credentials -> Create credentials -> OAuth client ID
#              -> Application type: Desktop app -> download the JSON.
# Also add your own Google address under OAuth consent screen -> Test users.
GOOGLE_OAUTH_CLIENT_FILE=./credentials/oauth_client.json
GOOGLE_TOKEN_FILE=./credentials/token.json

# --- Mode: service_account --------------------------------------------------
GOOGLE_CREDENTIALS_FILE=./credentials/service_account.json
#
# REQUIRED in service_account mode: create a blank sheet at https://sheets.new,
# share it as Editor with the `client_email` from the JSON key, then paste its
# id here (the long string between /d/ and /edit in its URL).
# GOOGLE_SPREADSHEET_ID=

# Only used for sheets the agent creates itself (oauth mode, or a Workspace
# Shared Drive): also grant this address access so the link is openable.
GOOGLE_SHARE_WITH_EMAIL=

GOOGLE_DEFAULT_SPREADSHEET_TITLE=Employee Data (Agent Import)


# ---- Retry policy ----------------------------------------------------------
TOOL_MAX_RETRIES=2
TOOL_RETRY_BASE_DELAY=1.0
